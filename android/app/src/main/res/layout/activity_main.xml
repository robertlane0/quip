<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/quip_bg">

    <!-- Top Connection Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@color/quip_bg_elevated">

        <EditText
            android:id="@+id/etHostIp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Host IP (e.g. 192.168.1.100)"
            android:textColorHint="@color/quip_text_secondary"
            android:textColor="@color/quip_text_primary"
            android:inputType="textUri"
            android:singleLine="true"
            android:textSize="15sp"
            android:background="@color/quip_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp" />

        <Spinner
            android:id="@+id/spinnerLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="130dp"
            android:background="@color/quip_bg" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/quip_accent"
            android:layout_marginStart="8dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- Status Text -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Disconnected"
        android:textColor="@color/quip_status_warn"
        android:gravity="center"
        android:padding="6dp"
        android:textSize="13sp"
        android:background="@color/quip_bg_bar" />

    <!-- Keyboard | Trackpad -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Keyboard Panel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KEYBOARD"
                android:textColor="@color/quip_text_hint"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:gravity="center"
                android:padding="10dp" />

            <FrameLayout
                android:id="@+id/keyboardContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="20dp" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/quip_divider" />

        <!-- Trackpad Panel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TRACKPAD"
                android:textColor="@color/quip_text_hint"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:gravity="center"
                android:padding="10dp" />

            <com.quip.client.TrackpadView
                android:id="@+id/trackpad"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="20dp"
                android:background="@drawable/bg_trackpad" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
