<?xml version="1.0" encoding="utf-8"?>
<!--
    QUIP Control Scheme Definition
    ===============================
    The freeform counterpart to a key-layout grid: elements are absolutely positioned
    (gravity + margins, like a FrameLayout child) and layered rather than placed in a
    row/column grid. Parsed by ControlSchemeParser, rendered by ControlSchemeBuilder — a
    new HUD is "add an XML file", same as key-layout XML files are for grid keyboards.

    <control-scheme name="...">

        <trackpad fullscreen="true" />
            A mouse surface. fullscreen="true" fills the whole scheme and is added first,
            so every other element sits on top of it in z-order. Anything not covered by a
            joystick/button's own hit area falls through to it automatically — no manual
            region math needed. Drag = move, tap = left click, double-tap = right click.

        <joystick size="dp" gravity="v|h" marginStart/End/Top/Bottom="dp"
                  bitUp/Down/Left/Right="BIT_CONSTANT_NAME"
                  [bitSprint="BIT_CONSTANT_NAME"] [floatRange="0.0-1.0"] />
            A virtual stick that drives up to 4 independent digital bits — diagonals
            naturally combine two bits, the same as holding two real keys would. gravity
            accepts any of: top, bottom, start, end, left, right, center,
            center_horizontal, center_vertical, combined with "|".
            bitSprint (optional): fired as a ~1.5s bounded pulse when the knob is pushed
            all the way to the track's edge (e.g. games where a brief Shift tap engages
            sprint) — cancelled early if released or pulled back off the edge sooner.
            floatRange (optional): lets the joystick "float" to wherever the player first
            taps, rather than sitting at one fixed spot. Value is the fraction of the
            screen's width/height (from the joystick's anchor corner) it's allowed to
            relocate within; omit for a classic fixed-position joystick.

        <button label="..." bit="BIT_CONSTANT_NAME" size="dp" gravity="v|h"
                marginStart/End/Top/Bottom="dp" />
            A circular press-and-hold button bound to one digital bit (see QuipProtocol
            for valid bit names, including mouse buttons like BIT_MOUSE_L).

    </control-scheme>
-->
<control-scheme name="Joystick HUD">

    <trackpad fullscreen="true" />

    <joystick
        size="250dp"
        gravity="bottom|start"
        marginStart="28dp"
        marginBottom="28dp"
        bitUp="BIT_W"
        bitDown="BIT_S"
        bitLeft="BIT_A"
        bitRight="BIT_D"
        bitSprint="BIT_SHIFT"
        floatRange="0.5" />

    <button
        label="Use (E key)"
        bit="BIT_E"
        size="125dp"
        gravity="bottom|end"
        marginEnd="40dp"
        marginBottom="199dp" />

    <button
        label="Attack/Destroy (Left Click)"
        bit="BIT_MOUSE_L"
        size="155dp"
        gravity="bottom|end"
        marginEnd="199dp"
        marginBottom="24dp" />

    <button
        label="Jump (space bar)"
        bit="BIT_SPACE"
        size="155dp"
        gravity="bottom|end"
        marginEnd="24dp"
        marginBottom="24dp" />

</control-scheme>
